[Unit]
Description=LVL - NetAtlas
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netatlas
Group=netatlas
WorkingDirectory=/opt/netatlas
EnvironmentFile=/etc/netatlas/netatlas.env
ExecStart=/opt/netatlas/venv/bin/uvicorn main:app --host 0.0.0.0 --port 20050 --workers 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
