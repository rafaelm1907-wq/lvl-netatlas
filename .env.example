# Copie para /etc/netatlas/netatlas.env durante a instalação. Nunca versione este arquivo preenchido.
NETBOX_URL=http://netbox.exemplo.local
NETBOX_TOKEN=token-do-netbox-com-permissao-de-escrita
ZABBIX_DB_HOST=zabbix-db.exemplo.local
ZABBIX_DB_PORT=3306
ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=netatlas
ZABBIX_DB_PASSWORD=senha-do-usuario-somente-leitura
NETATLAS_DB_DSN=postgresql://netatlas_app:senha-local@127.0.0.1/netatlas
NETATLAS_SUPERADMIN_PASSWORD=defina-uma-senha-forte
LICENSE_SERVER_URL=https://lvllicencas.lvltech.com.br
LICENSE_PRODUCT=LVL - NetAtlas
OLT_MANAGER_URL=http://gerenciador-olts.exemplo.local:6000
OLT_MANAGER_TOKEN=token-somente-leitura-gerado-no-gerenciador
